# Copy this file to `.env` and fill in your own values (.env is git-ignored).
# On Vercel set the SAME names under Project > Settings > Environment Variables.

# ── Browser-side (VITE_ prefix = ends up in the public bundle; only put public keys here) ──
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Image hosting for nodes (so images survive share links instead of being
# embedded as base64). Get these from: Cloudinary Dashboard -> Settings ->
# Upload -> Upload presets. Create a new preset with "Signing Mode" set to
# "Unsigned" (safe to expose client-side — it can only accept uploads, not
# read your account). Cloud name is shown at the top of the Cloudinary
# Dashboard home page.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset-name

# ── Server-side only: live XAUUSD data for the Demo Terminal (Phase 14) ──
# IMPORTANT: these must NOT start with VITE_ — they are read by api/*.js on the server and never
# reach the browser. `npm run build` + `node tests/secret-scan.mjs` checks that.

# Which data provider the /api/* functions use. Only "twelvedata" is built in.
FEED_PROVIDER=twelvedata

# Your Twelve Data key: https://twelvedata.com -> free account -> Dashboard -> API keys.
TWELVEDATA_API_KEY=

# Origin(s) allowed to call /api/* (CORS), comma separated, e.g. https://mind-map0-1.vercel.app
# Leave empty to allow same-origin requests only (right for the normal setup).
ALLOWED_ORIGIN=

# Optional: a relay URL if you ever put one in front of the provider (not used by default).
# FEED_RELAY_URL=
