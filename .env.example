# Copy this file to `.env` and fill in your own Supabase project's values.
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Image hosting for nodes (so images survive share links instead of being
# embedded as base64). Get these from: Cloudinary Dashboard -> Settings ->
# Upload -> Upload presets. Create a new preset with "Signing Mode" set to
# "Unsigned" (safe to expose client-side — it can only accept uploads, not
# read your account). Cloud name is shown at the top of the Cloudinary
# Dashboard home page.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset-name
